{
  "//": "c:\\Coding\\OpenCafe\\cafe-pos\\package.json",
  "name": "cafe-pos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run start",
    "build": "npm run build --workspaces",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "migrate": "npm --workspace backend run migrate"
  }
}

